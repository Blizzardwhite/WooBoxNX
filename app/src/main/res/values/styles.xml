<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:colorPrimary">@color/white</item>
        <item name="android:colorPrimaryDark">@color/foreground</item>
        <item name="android:colorAccent">@color/colorAccent</item>
        <!-- Customize your theme here. -->
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:forceDarkAllowed">true</item>
    </style>

<!-- MD3 主题：新的设置界面 -->
    <style name="Theme.WooBoxM3" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorOnPrimary">@color/m3_on_primary</item>
        <item name="colorPrimaryContainer">@color/m3_primary_container</item>
        <item name="colorSecondaryContainer">@color/m3_primary_container</item>
        <item name="colorOnSecondaryContainer">@color/m3_on_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/m3_on_primary_container</item>
        <item name="colorSurface">@color/m3_surface</item>
        <item name="colorOnSurface">@color/m3_on_surface</item>
        <item name="colorSurfaceVariant">@color/m3_surface_container</item>
        <item name="colorOnSurfaceVariant">@color/m3_on_surface_variant</item>
        <item name="colorOutlineVariant">@color/m3_outline_variant</item>
        <item name="colorOutline">@color/m3_outline_variant</item>
        <!-- 弹窗、开关、滑块用到的容器色，不覆盖会掉回默认的紫色调 -->
        <item name="colorSurfaceContainerLowest">@color/m3_surface</item>
        <item name="colorSurfaceContainerLow">@color/m3_surface_container</item>
        <item name="colorSurfaceContainer">@color/m3_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/m3_surface_container</item>
        <item name="colorSurfaceContainerHighest">@color/m3_surface_high</item>
        <item name="colorSurfaceBright">@color/m3_surface_container</item>
        <item name="colorSurfaceDim">@color/m3_surface</item>
        <item name="colorOnSurfaceInverse">@color/m3_on_surface</item>
        <item name="colorSurfaceInverse">@color/m3_surface_container</item>
        <item name="android:colorBackground">@color/m3_surface</item>
        <item name="android:statusBarColor">@color/m3_surface</item>
        <item name="android:navigationBarColor">@color/m3_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

</resources>